# Copy to .env for local development. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Manila

# Postgres (also read by the postgres container to create the DB and user)
POSTGRES_DB=restocore
POSTGRES_USER=restocore
POSTGRES_PASSWORD=restocore
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RestoCore
RESTAURANT_NAME=Little Roast Café
# Sales tax added to menu prices, as a fraction (0.12 = 12%)
SALES_TAX_RATE=0.12
# Password given to every demo account by `manage.py seed_demo` (local demo only)
DEMO_PASSWORD=restocore-demo
# Read-only API for the MCP server. Leave empty to disable the API. At least 16 characters; for
# anything beyond local development generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RESTOCORE_API_TOKEN=local-dev-api-token
# MCP server only: where the API lives (default http://127.0.0.1:8000).
# RESTOCORE_API_URL=http://127.0.0.1:8000
# Currency symbol shown with prices (default: peso sign).
# CURRENCY_SYMBOL=₱
# Ask RestoCore (owner AI assistant). Free key: https://aistudio.google.com/apikey. Empty = off.
GEMINI_API_KEY=
# ASSISTANT_MODEL=gemini-flash-latest
# ASSISTANT_HOURLY_LIMIT=20
# ASSISTANT_DAILY_LIMIT=200
# Send pay rates and payslips to the assistant (Google). On in DEMO_MODE (fake data); real payroll
# must opt in with true.
# ASSISTANT_ALLOW_PAYROLL=false

# --- Hosting only (see docs/deploy.md); leave unset for local development ---
# One URL instead of the POSTGRES_* values above (e.g. Neon). Takes precedence when set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Public demo: list demo accounts on the login page, block password changes, no admin for owner.
# DEMO_MODE=false
# Wipe and reseed all data every time the container starts (bin/start.sh). Public demo only!
# DEMO_RESET_ON_START=false
# With DEMO_RESET_ON_START: also reset once a day at this hour (0-23, DJANGO_TIME_ZONE).
# DEMO_RESET_HOUR=4
# HTTPS redirect, secure cookies and HSTS (set when TLS is terminated in front of the app).
# DJANGO_HTTPS=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false
# Fingerprinted, cacheable static files (needs collectstatic; the production image does it).
# DJANGO_STATIC_MANIFEST=true
# Extra origins allowed to POST forms, comma separated (Render's hostname is added for you).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DEBUG, INFO, WARNING, ERROR
# DJANGO_LOG_LEVEL=INFO
# gunicorn workers (production image) and the port it listens on (hosts usually set PORT).
# WEB_CONCURRENCY=2
# PORT=8000
# Header with the real visitor IP, set by a proxy that overwrites it (sign-in throttling).
# CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
