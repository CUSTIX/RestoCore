# Copy to .env for local development. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Manila

# Postgres (also read by the postgres container to create the DB and user)
POSTGRES_DB=restocore
POSTGRES_USER=restocore
POSTGRES_PASSWORD=restocore
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RestoCore
RESTAURANT_NAME=Casa Verde
# Sales tax added to menu prices, as a fraction (0.12 = 12%)
SALES_TAX_RATE=0.12
# Password given to every demo account by `manage.py seed_demo` (local demo only)
DEMO_PASSWORD=restocore-demo
# Read-only API for the MCP server. Leave empty to disable the API.
RESTOCORE_API_TOKEN=local-dev-api-token
